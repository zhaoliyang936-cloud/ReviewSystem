# Set in shell; not automatically loaded
DB_URL=jdbc:postgresql://localhost:5432/reviewsystem
DB_USER=reviewsystem
DB_PASSWORD=replace-locally
SERVER_PORT=8080
AI_ENABLED=false

# Set only for initial creation, then remove; never commit real values
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set true behind HTTPS, including the HTTPS reverse proxy
COOKIE_SECURE=false
