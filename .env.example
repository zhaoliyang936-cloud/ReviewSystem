# ReviewSystem 本地运行配置模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，绝不会入库。
#
# 注入方式（任选其一）：
#   1) 命令行：  set -a; . ./.env; set +a;   然后启动后端（同一终端）
#   2) IDE：     把下面各项逐条填进 Run Configuration 的 Environment variables
#
# 注意：
#   - AI_BASE_URL 末尾不要带斜杠，客户端会自行拼 /chat/completions
#   - 值里有空格或特殊字符时要加引号

# ---------- AI 供应方（OpenAI 兼容接口）----------
# 示例为硅基流动；换别家只改这三行
AI_ENABLED=false
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
AI_API_KEY=<your-api-key>

# 可选调优，留空则用 application.yml 默认值
AI_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=2
AI_PREPARE_TIMEOUT_SECONDS=90
AI_MASTERY_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=4096
AI_JSON_MODE=auto
AI_DAILY_CALL_LIMIT=200
AI_DUPLICATE_THRESHOLD=0.85

# ---------- 数据库（本机 trust 免密）----------
DB_URL=jdbc:postgresql://127.0.0.1:5432/reviewsystem
DB_USER=postgres
DB_PASSWORD=
